# Optional: override backend URL for dev (leave blank for production / LAN deploy).
# Production builds use relative paths (/api/...) so tablets work at http://server-ip
VITE_BACKEND_URL=

# GEMINI_API_KEY: Required for Gemini AI API calls (AI Studio only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosting URL (AI Studio only).
APP_URL="MY_APP_URL"
